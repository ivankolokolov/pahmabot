# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff

# ID канала (числовой ID, например -1001234567890, или @username канала)
CHANNEL_ID=-1001234567890

# Прокси, если хостинг блокирует Telegram (необязательно).
# http(s):// или socks5://[user:pass@]host:port. Пусто — прямое подключение.
# TELEGRAM_PROXY=socks5://user:pass@1.2.3.4:1080
